# Auth & secrets
auths/
data/
*.key
*.pem
*.env
.env
.env.*

# Binaries (anchored to repo root only — bare "login"/"credit" would also ignore cmd/login/, cmd/credit/)
/login
/credit
/wb2api
/signin_bin

# Config with secrets (use config.example.json)
config.json

# Build artifacts
*.tmp
__pycache__/

# Backups (contains auth tokens)
backups/

# IDE
.idea/
.vscode/
LOOP.md
PLAN.md
SPEC.md
docs/

# 设计/计划文档（但 README.md 必须进版本库）
*.md
!README.md

# Windows binaries
/wb2api.exe
/login.exe
/credit.exe

# 本地验证工具（判据逆向过程脚本，结论沉淀于 data/desktop-task-protocol.md）
/cmd/desktopverify*/
*.zip
server.exe

# 快照产物（tools/*.sh 进库，快照本身不进）
tools/snapshots/

# 本地回归脚本与验收手册：只在本机工作区跑，不进仓库
# （源码副本在工作区根目录 tests/ 之外，结论沉淀在桌面《运维速查》《验收标准》）
/tests/
/docs/
tools/t_compat.py

# go:embed 资源必须进库（上面的 *.md 会把它们一起忽略掉，缺了编译不过）
!internal/prompt/defaultprompt.md
!internal/**/*.md
